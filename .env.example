# Copy to .env and fill in. .env is gitignored — never commit the token.

# From @BotFather: /newbot, then /token if you need to see it again.
BOT_TOKEN=

# Public HTTPS URL of the built game. With the bundled GitHub Pages workflow:
# https://<your-github-user>.github.io/BrokerStars/
WEBAPP_URL=

# Your Telegram user id, to show the developer buttons (free purchases, undo).
# Only hides them from other players — it ends up in the built JS, and the id it
# is compared against comes from Telegram's unsigned initDataUnsafe.
# On GitHub it lives in the repository secret MY_ID.
VITE_ADMIN_ID=

# The leaderboard Worker (see worker/README.md). Leave empty and the RATING tab
# says so instead of spinning; matches are still played and stars still earned.
# On GitHub it lives in the repository variable API_URL.
VITE_API_URL=
