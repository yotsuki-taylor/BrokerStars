{
  "name": "broker-stars-worker",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "schema": "wrangler d1 execute broker-stars --remote --file=./schema.sql",
    "schema:local": "wrangler d1 execute broker-stars --local --file=./schema.sql",
    "migrate": "wrangler d1 execute broker-stars --remote --file=./migrations/001-results-token.sql",
    "migrate:local": "wrangler d1 execute broker-stars --local --file=./migrations/001-results-token.sql",
    "test": "vitest run"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260903.1",
    "typescript": "^5.6.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.129.0"
  }
}
