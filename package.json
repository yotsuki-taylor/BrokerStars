{
  "name": "broker-stars",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "sim": "tsx src/headless/run.ts",
    "bot": "node bot/bot.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:android": "tsc -b && vite build --mode android",
    "android": "npm run build:android && cap sync android",
    "android:open": "cap open android",
    "icons": "node assets/build-icons.mjs && cap assets generate --android && node assets/shrink-splash.mjs"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.1",
    "@capacitor/share": "^8.0.1",
    "@capgo/capacitor-social-login": "^8.5.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.1",
    "@types/node": "^26.4.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^4.1.11"
  }
}
