node_modules
dist
tsconfig.tsbuildinfo

# licensed display font, supplied separately (see README)
*.ttf

# bot token lives here
.env

# worker build state, local D1, and the throwaway token a local run needs
worker/node_modules
worker/.wrangler
.dev.vars

# Database dumps taken before a migration. Real rows: Telegram user ids and the
# names people chose, which is not something to put in a public repository.
# Kept out of git on purpose, and kept on disk on purpose — see worker/README.md.
worker/backups

# Everything assets/build-icons.mjs makes out of source-icon.png, which is 6.4
# MB of PNG that a script rewrites from scratch on every run. Committing them
# means carrying the same drawing six times and leaving the next reader to work
# out which copy is the one to edit. The answer is source-icon.png; the rest is
# what "npm run icons" makes of it.
assets/icon.png
assets/icon-foreground.png
assets/icon-background.png
assets/splash.png
assets/splash-dark.png

# Icon previews, regenerated by assets/preview-adaptive.mjs whenever the art
# changes. Looking at them is the point; keeping them is not.
assets/_preview*.png

# The listing's own pictures: the 512 tile and the banner, both drawn by
# assets/build-store.mjs from the same master as everything else, and the
# screenshots, cut by assets/build-screens.mjs from captures off a phone.
#
# Out for the reason the icon sources are out, and one more. They are derived,
# so the script is the thing worth keeping. And once uploaded they live in Play
# Console, which is where a listing's pictures belong — a megabyte of PNG in
# every clone of this repository, forever, for files needed once, buys nothing.
#
# What stays is assets/store/listing.md, and it stays for the opposite reason:
# it is text, it is small, and it goes stale when the code changes. That is
# precisely what version control is for.
assets/play-icon-512.png
assets/play-feature-graphic.png
assets/store/*.png

# Signing keys, anywhere in the tree. `android/.gitignore` covers only the
# android/ subtree, and a key made in whatever folder the terminal happened to
# be in would be untracked but offered by `git add .` — into a public
# repository. The upload key cannot be regenerated: see
# android/keystore.properties.example.
*.jks
*.keystore
