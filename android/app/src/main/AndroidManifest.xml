<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
                Invitations: brokerstars://duel/<code> and brokerstars://friend/<code>.
                Reshaped into the `duel_<code>` and `friend_<code>` strings the game
                already reads out of a Telegram launch - see src/platform/android.ts.

                A scheme of our own, which is what the page falls back to when the
                App Link below has not verified, and what every invitation sent
                before it existed still uses.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="brokerstars" />
            </intent-filter>

            <!--
                The same invitations as ordinary web addresses, which is what an
                invitation should have been all along: one link that opens the
                app where it is installed and the web game where it is not, with
                nobody asked to choose between them.

                `autoVerify` is what makes that happen without a chooser, and it
                is not a claim this file can make on its own. Android fetches
                https://yotsuki-taylor.github.io/.well-known/assetlinks.json and
                will only route these links here if that file names this package
                and the SHA-256 of the certificate this build was signed with.
                The file to serve is `android/assetlinks.json`, and it has to sit
                at the root of the HOST — the user site repository — not inside
                this project's pages. It names three certificates: Play's own,
                which is what anybody installing from the store gets; the upload
                key, for an APK handed round directly; and the debug key, so a
                local build verifies too.

                Until it verifies, nothing breaks: these links open in a browser
                exactly as they do today, and the page there offers the app by
                the custom scheme above.

                Narrowed by path on purpose. Verification is granted for a whole
                host, and that host carries every other page of that GitHub
                account; the prefix is what keeps this app from claiming them.
            -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="yotsuki-taylor.github.io"
                    android:pathPrefix="/BrokerStars/" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        One notification, and only one: the duel you opened has been accepted
        and is already running. Android 13 and up ask the player before any of
        them are shown, which the game does at the moment the reason is on
        screen rather than on the way in (see `askToNotify` in
        src/platform/android.ts). Refusing it costs nothing but the reminder.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
</manifest>
