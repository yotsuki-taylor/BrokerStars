# Copy to android/keystore.properties and fill in. That file is gitignored and
# this repository is public: it names a key that nobody else can be allowed to
# have, and holds the passwords to it in plain text.
#
# THE KEY ITSELF BELONGS OUTSIDE THIS FOLDER. Point `storeFile` at somewhere it
# cannot be swept up by an archive of the project -- and keep a second copy of
# it somewhere that is not this computer. It is the only proof that a new
# release of this app comes from us: lose it and the app can never be updated
# again under the same listing, and no appeal recovers it.
#
# Make one with (all on one line, run wherever the key should live):
#
#   keytool -genkeypair -v -keystore brokerstars-upload.jks -alias upload \
#           -keyalg RSA -keysize 2048 -validity 10000
#
# `keytool` comes with the JDK that Android Studio ships:
#   "E:\Program Files\AndroidStudio\jbr\bin\keytool.exe"
#
# 10000 days is about twenty-seven years. Play wants a key that outlives the
# app, and a short one is a cliff nobody remembers walking towards.

# Absolute path, forward slashes even on Windows.
storeFile=C:/Users/Masha/keys/brokerstars-upload.jks
storePassword=
keyAlias=upload
keyPassword=
